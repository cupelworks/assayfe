# Assay's front end: the built app, and /api forwarded to the API.
# When the container starts, the image fills in the ASSAY_API_URL and ASSAY_UPLOAD_MAX_MB below
# (only ASSAY_* variables); nginx's own variables stay as they are.

# Who is signed in, as the sign-in in front tells it: X-MS-CLIENT-PRINCIPAL, base64 JSON. Kept only
# when it's base64 and nothing else, as /.assay/me puts it into a JSON string.
map $http_x_ms_client_principal $signed_in_principal {
    "~^[A-Za-z0-9+/=]+$" $http_x_ms_client_principal;
    default "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    absolute_redirect off;

    # The sign-in adds its X-MS-CLIENT-PRINCIPAL headers to every request. For someone in many
    # groups one can pass nginx's 8 KB default, and every request of theirs would be refused.
    large_client_header_buffers 4 32k;

    # A dataset upload passes through here: one megabyte more than the API's own limit, for the
    # form around the file.
    client_max_body_size ${ASSAY_UPLOAD_MAX_MB}m;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # For the platform's liveness and readiness probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Who is signed in, for the header's name and Sign out: the sign-in's X-MS-CLIENT-PRINCIPAL as
    # the platform sent it, or "" with no sign-in in front (locally). For display only - where the
    # platform isn't in front, anyone can send that header. Never logged, never cached.
    location = /.assay/me {
        access_log off;
        default_type application/json;
        include /etc/nginx/assay/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 '{"principal":"$signed_in_principal"}';
    }

    # The API, with /api taken off the path (proxy_pass ends in "/"), whatever a path's name: "^~"
    # keeps the built-files rule below from ever taking one. Every request header goes along, the
    # sign-in's X-MS-CLIENT-PRINCIPAL* among them. Over HTTPS the API is reached by its own name
    # (SNI and Host), and its certificate is checked against the image's CA bundle. The API's
    # answers keep their own headers: its docs page loads its scripts from elsewhere, which the
    # app's policy below would block.
    location ^~ /api/ {
        proxy_pass ${ASSAY_API_URL}/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_set_header Host $proxy_host;
    }

    # Built files carry a hash in their name (letters, digits, "-" and "_") and never change:
    # cached for a year. A missing one is a 404, not the app - and not cached (no "always" on
    # Cache-Control).
    location ~* "-[a-z0-9_-]{8,10}\.(?:js|css|woff2)$" {
        include /etc/nginx/assay/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Everything else, the app's own routes included: the file if there is one, else index.html.
    # Checked again on every visit (no-cache), so a release shows at once.
    location / {
        include /etc/nginx/assay/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
