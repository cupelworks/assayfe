# Checks Assay's settings before nginx's templates are filled in (20-envsubst-on-templates.sh).
# Sourced by the image's entrypoint, so the cleaned value is the one the template gets.

if [ -z "${ASSAY_API_URL:-}" ]; then
    echo "assay-fe: ASSAY_API_URL is not set - the API's address, such as https://assay-api.internal.example" >&2
    exit 1
fi
# proxy_pass adds the "/" itself: one more would double it.
export ASSAY_API_URL="${ASSAY_API_URL%/}"

case "${ASSAY_UPLOAD_MAX_MB:-}" in
    '' | *[!0-9]*)
        echo "assay-fe: ASSAY_UPLOAD_MAX_MB must be a whole number of megabytes, not '${ASSAY_UPLOAD_MAX_MB:-}'" >&2
        exit 1
        ;;
    *[1-9]*) ;;
    # To nginx, 0 is no limit at all.
    *)
        echo "assay-fe: ASSAY_UPLOAD_MAX_MB must be at least 1 - to nginx, 0 means no limit" >&2
        exit 1
        ;;
esac
